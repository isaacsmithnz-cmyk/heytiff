# Production feature flags (public, build-time inlined — NOT secrets).
# Studio simulation mode: split-system airflow/temperature sim, read-only.
NEXT_PUBLIC_STUDIO_SIM=1
# Studio multi-split module: several rooms on one outdoor, an indoor unit per
# room. The combination tables are in the pack (#729), so a set is judged
# against the book rather than a port count.
NEXT_PUBLIC_STUDIO_MULTI=1
