{
  "name": "heytiff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "sh .githooks/install.sh",
    "test:watch": "jest --watch",
    "validate:packs": "PACK_REPORT=1 jest installed-packs",
    "bakeoff": "BAKEOFF=1 jest src/lib/voice/bakeoff/__tests__/bakeoff.test.ts --verbose --silent=false",
    "dev:preview": "NEXT_DIST_DIR=.next-preview.nosync next dev",
    "dev:verify": "NEXT_DIST_DIR=.next-verify.nosync next dev -p 3200",
    "auth0:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/auth0-brand.mts",
    "auth0:brand:preview": "npm run auth0:brand -- --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@auth0/nextjs-auth0": "^4.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "xero-node": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
